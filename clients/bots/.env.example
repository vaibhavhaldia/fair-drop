# The bot driver reads plain process env — there is no dotenv dependency. Either export these,
# or pass the file explicitly:
#
#   node --env-file=.env --experimental-strip-types src/turn.ts auto <eventId> <dbName>
#
# Unset, the driver talks to `http://127.0.0.1:3000`, which is right for a local rehearsal.

# Where the module lives. https:// for Maincloud; the SDK upgrades it to wss:// itself.
FAIRDROP_URI=https://maincloud.spacetimedb.com

# How long a bot waits for the event to reach `open` before giving up. The default is 30
# minutes — a leak guard, not a real limit, so an abandoned driver eventually exits. Lower it
# only if you want a failed rehearsal to fail fast.
# FAIRDROP_OPEN_TIMEOUT_MS=1800000
